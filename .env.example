# Backend API URL (leave empty to use mock data)
NEXT_PUBLIC_API_URL=http://localhost:3000

# API key for the backend (required when NEXT_PUBLIC_API_URL is set)
NEXT_PUBLIC_API_KEY=your-api-key-here

# Feature flags (resolved at build time — rebuild after changing)
# Retail module: retailer sign-up, ordering, and order/retailer admin pages.
# Off unless exactly "true".
NEXT_PUBLIC_FEATURE_RETAIL=false
