# Shared MieTech backend (mietechnologies_website_backend). Leave empty to use mock data.
# Sign-in uses the backend's session cookie, so this origin must list the catalog
# in its CORS_ALLOW_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Main MieTech site, linked from the login and profile pages
NEXT_PUBLIC_MAIN_SITE_URL=http://localhost:3000

# Feature flags (resolved at build time — rebuild after changing; setting these
# on a running server or container has no effect. Not access control: the backend
# still enforces its own auth.)
# Retail module: retailer sign-up, ordering, and order/retailer admin pages.
# Off unless exactly "true".
NEXT_PUBLIC_FEATURE_RETAIL=false
